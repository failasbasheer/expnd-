<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch window, shown until Flutter draws its first frame.
     Mirrors the iOS LaunchScreen storyboard exactly — ink background with the
     gold "E" in a 200dp box — so the handoff into SplashScreen is seamless
     on both platforms. Ink is hard-coded (not ?android:colorBackground) so the
     app never flashes white on its way in, whatever the OS light/dark setting. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ink" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
