<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/expnd_widget_bg"
    android:padding="16dp">

    <!-- Header: left to spend (or month spend) + quick-add -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_net_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LEFT TO SPEND"
                android:textColor="@color/widget_muted"
                android:textSize="10sp"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/widget_net_worth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="—"
                android:textColor="@color/widget_gold"
                android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ ADD"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:background="@drawable/expnd_widget_add"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp" />
    </LinearLayout>

    <!-- Month spend line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_month_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SPENT"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_month_spent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_budget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text=""
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:singleLine="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@color/widget_divider" />

    <!-- Recent transactions -->
    <LinearLayout
        android:id="@+id/tx_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tx_note_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tx_amount_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tx_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tx_note_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tx_amount_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tx_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tx_note_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tx_amount_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No transactions yet"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
