<?xml version="1.0" encoding="utf-8"?>
<!-- v21+ launch window. Kept identical to the base drawable: ink + centred
     gold "E", matching the iOS LaunchScreen storyboard. See the base
     drawable/launch_background.xml for why ink is hard-coded. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ink" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
